<Project Sdk="Microsoft.NET.Sdk">

  <!-- The logic that decides things, tested without the machine it usually reads: powercfg's output, the verdicts,
       what counts as noise from a controller, when the away group acts, and what gets written to disk. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- For the startup task, which lives with the window. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhyNotSleeping.Core\WhyNotSleeping.Core.csproj" />
    <ProjectReference Include="..\..\src\WhyNotSleeping.Gui\WhyNotSleeping.Gui.csproj" />
  </ItemGroup>

</Project>
